# Copy to .env. Two sets of models: convy's, which play the user and the judge (models.py),
# and Ouroboros's own, which it is tested with.

# convy's models: any OpenAI-compatible API.
GW_BASE_URL=https://llm.example.com/v1
GW_API_KEY=

# Ouroboros's models and the key of their provider. With OpenRouter:
OPENROUTER_API_KEY=
OUROBOROS_MODEL=google/gemini-3.8-flash
OUROBOROS_MODEL_LIGHT=openai/gpt-6-luna
# Or with an OpenAI-compatible gateway, the same one as above if you like:
# OPENAI_COMPATIBLE_BASE_URL=https://llm.example.com/v1
# OPENAI_COMPATIBLE_API_KEY=
# OUROBOROS_MODEL=openai-compatible::gpt-4.1
# OUROBOROS_MODEL_LIGHT=openai-compatible::gpt-4.1-mini
# Or with GigaChat, through the gpt2giga proxy, which speaks OpenAI's API (see README);
# GW_BASE_URL above may point at it too, for convy's user and judge:
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8090/v1
# OPENAI_COMPATIBLE_API_KEY=             # gpt2giga's GPT2GIGA_API_KEY, if it asks for one
# OUROBOROS_MODEL=openai-compatible::GigaChat-2-Max
# OUROBOROS_MODEL_LIGHT=openai-compatible::GigaChat-2-Max

# Each server's spending limit in dollars, and its workers (3 keeps a laptop's memory free).
# OUROBOROS_BUDGET_USD=10
# OUROBOROS_MAX_WORKERS=3
